generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                   String             @id @default(uuid())
  name                 String
  email                String             @unique
  phone                String?
  dateOfBirth          String?
  password             String
  role                 Role               @default(PATIENT)
  isEmailVerified      Boolean            @default(false) @map("is_email_verified")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  preferences          Json?
  notificationSettings Json?
  privacySettings      Json?
  medicalInfo          Json?
  appointments         Appointment[]
  doctorProfile        Doctor?
  favorites            Favorite[]
  favoritePharmacies   FavoritePharmacy[]
  pharmacyProfile      Pharmacy?
  reviews              Review[]
  orders               Order[]
}

model Specialty {
  id      String   @id @default(uuid())
  name    String   @unique
  icon    String?
  doctors Doctor[]
}

model Doctor {
  id              String         @id @default(uuid())
  userId          String         @unique @map("user_id")
  specialtyId     String         @map("specialty_id")
  bio             String?
  clinicAddress   String         @map("clinic_address")
  city            String?        @default("Tunis")
  country         String?        @default("Tunisia")
  latitude        Float?
  longitude       Float?
  avatar          String?
  currency        String         @default("TND")
  ratingAverage   Float          @default(0) @map("rating_average")
  consultationFee Float          @default(100) @map("consultation_fee")
  phone           String?
  appointments    Appointment[]
  availabilities  Availability[]
  specialty       Specialty      @relation(fields: [specialtyId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites       Favorite[]
  reviews         Review[]

  @@index([specialtyId])
}

model Availability {
  id        String @id @default(uuid())
  doctorId  String @map("doctor_id")
  date      String // specific date: "2026-07-07"
  startTime String
  endTime   String
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
}

model Review {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  doctorId  String   @map("doctor_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model Appointment {
  id        String            @id @default(uuid())
  doctorId  String            @map("doctor_id")
  patientId String            @map("patient_id")
  date      DateTime
  startTime String
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  patient   User              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([doctorId, date, startTime])
  @@index([patientId])
}

model Favorite {
  id        String @id @default(uuid())
  patientId String @map("patient_id")
  doctorId  String @map("doctor_id")
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  payload   Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id                    String        @id @default(uuid())
  appointmentId         String?       @map("appointment_id")
  orderId               String?       @map("order_id")
  amount                Float
  method                String
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  createdAt             DateTime      @default(now())
  appointment           Appointment?  @relation(fields: [appointmentId], references: [id])
  order                 Order?        @relation(fields: [orderId], references: [id])
}

model Pharmacy {
  id            String             @id @default(uuid())
  userId        String             @unique @map("user_id")
  address       String?
  city          String?            @default("Tunis")
  country       String?            @default("Tunisia")
  latitude      Float?
  longitude     Float?
  phone         String?
  isOpen        Boolean            @default(true)
  hoursWeekdays String?            @default("08:00 - 22:00")
  hoursSaturday String?            @default("08:00 - 20:00")
  hoursSunday   String?            @default("Closed")
  deliveryFee   Float              @default(7.00) @map("delivery_fee")
  avatar        String?
  favorites     FavoritePharmacy[]
  medicines     Medicine[]
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
}

model Medicine {
  id            String      @id @default(uuid())
  pharmacyId    String      @map("pharmacy_id")
  name          String
  description   String?
  price         Float       @default(0)
  stock         Int         @default(100)
  status        String      @default("AVAILABLE") // "AVAILABLE", "OUT_OF_STOCK", "PRESCRIPTION_REQUIRED"
  requireUpload Boolean     @default(true) @map("require_upload")
  pharmacy      Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([pharmacyId])
}

model Order {
  id              String      @id @default(uuid())
  patientId       String      @map("patient_id")
  pharmacyId      String      @map("pharmacy_id")
  status          String      @default("PENDING") // "PENDING", "PAID", "COMPLETED", "CANCELLED"
  totalPrice      Float
  prescriptionUrl String?     @map("prescription_url")
  deliveryMethod  String      @default("PICKUP") @map("delivery_method")
  deliveryAddress String?     @map("delivery_address")
  deliveryPhone   String?     @map("delivery_phone")
  deliveryFee     Float       @default(0) @map("delivery_fee")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  patient         User        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy        Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payments        Payment[]

  @@index([patientId])
  @@index([pharmacyId])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  medicineId String   @map("medicine_id")
  quantity   Int
  price      Float
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
}

model FavoritePharmacy {
  id         String   @id @default(uuid())
  patientId  String   @map("patient_id")
  pharmacyId String   @map("pharmacy_id")
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patient    User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, pharmacyId])
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  PHARMACY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
