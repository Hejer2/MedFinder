# ==============================================================================
# MedFinder Environment Configuration Template
# Copy this file to .env and customize values for local development or production
# ==============================================================================

# Backend & Database
NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"

# PostgreSQL (When running with Docker Compose or Postgres)
POSTGRES_USER=medfinder
POSTGRES_PASSWORD=medfinder_secret
POSTGRES_DB=medfinder
DB_PORT=5432

# Authentication & Security
JWT_SECRET=change_me_to_a_strong_random_secret_in_production_32chars
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change_me_to_a_strong_random_refresh_secret_32chars
REFRESH_EXPIRES_IN=7d

# CORS & Domain Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Mailing (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_SECURE=false

# Stripe Payment Gateway & Webhook Signature Verification
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Optional Cloud / CD Deploy Hooks (Render)
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-placeholder?key=placeholder
